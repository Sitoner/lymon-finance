# Copia este archivo como .env.local para trabajar en local. En Vercel van en Settings › Environment Variables.

# Base de datos Postgres (Neon, desde Vercel › Storage). Sin ella, en local se usa un Postgres embebido en data/pglite
DATABASE_URL=

# Login con Google (Google Cloud Console › APIs y servicios › Credenciales › ID de cliente de OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave para firmar la sesión: 32 caracteres o más, aleatorios. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LYMON_SECRET=

# Única cuenta con acceso (por defecto apastor@lymon.es)
LYMON_EMAIL=apastor@lymon.es

# Solo en local (npm run dev): 1 = entrar sin Google. No tiene efecto en Vercel.
LYMON_DEV_SIN_LOGIN=
